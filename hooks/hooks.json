{
  "description": "Desk Studio: records desk starts and stops, tool counts and session edges to .desk/events.jsonl for the dashboard. Only names, numbers and paths, never prompt text.",
  "hooks": {
    "SessionStart": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/emit-event.mjs", "--hook"], "timeout": 5 } ] }
    ],
    "SubagentStart": [
      { "matcher": "^desk:", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/emit-event.mjs", "--hook"], "timeout": 5 } ] }
    ],
    "SubagentStop": [
      { "matcher": "^desk:", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/emit-event.mjs", "--hook"], "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/emit-event.mjs", "--hook"], "timeout": 5 } ] }
    ],
    "Stop": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/emit-event.mjs", "--hook"], "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/emit-event.mjs", "--hook"], "timeout": 5 } ] }
    ]
  }
}
